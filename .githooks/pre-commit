#!/usr/bin/env bash
# Blocks committing .env files and credential-looking strings.
set -u

fail=0

# 1. Staged .env files (anything but .env.example)
bad_files=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '(^|/)\.env($|\.)' | grep -vE '(^|/)\.env\.example$')
if [ -n "$bad_files" ]; then
  echo "pre-commit: refusing to commit env file(s):"
  echo "$bad_files" | sed 's/^/  /'
  fail=1
fi

# 2. Added lines that look like secrets
pattern='sk-or-v1-[A-Za-z0-9]{20,}|sk-(proj-|ant-)?[A-Za-z0-9_-]{20,}|pa-[A-Za-z0-9_-]{30,}|mongodb(\+srv)?://[^<:/@[:space:]]+:[^<@[:space:]]+@'
hits=$(git diff --cached -U0 --no-color | awk '
  /^\+\+\+ / { file = substr($0, 7); next }
  /^\+/      { print file ": " substr($0, 2) }
' | grep -E "$pattern")
if [ -n "$hits" ]; then
  echo "pre-commit: possible secret(s) in staged changes:"
  while IFS= read -r line; do
    file=${line%%: *}
    printf '%s\n' "${line#*: }" | grep -oE "$pattern" | sed "s|^|  $file: |"
  done <<< "$hits"
  fail=1
fi

if [ "$fail" -ne 0 ]; then
  echo "pre-commit: commit blocked. Bypass knowingly with git commit --no-verify"
  exit 1
fi
exit 0
