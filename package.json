{
  "name": "mongo-hack",
  "module": "src/check.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "mongodb": "^7.6.0",
    "openai": "^7.23.0",
    "voyageai": "^0.4.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "check": "bun run src/check.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks",
    "server": "bun run src/server.ts",
    "setup": "bun run scripts/setup-indexes.ts",
    "smoke": "bun run scripts/smoke.ts",
    "watch": "bun run src/watch.ts",
    "demo:layout": "bash layout/herdr.sh",
    "demo:layout:tmux": "bash layout/tmux.sh",
    "harness": "bun run demo/harness.ts",
    "harness:fresh": "bun run demo/harness.ts --fresh",
    "harness:invoice": "bash demo/reset.sh && bun run demo/harness.ts --task invoice --fresh",
    "demo:langgraph": "bun run demo/harness.ts",
    "demo:reset": "bash demo/reset.sh",
    "demo:clean": "bash demo/reset.sh && bun run demo/clean.ts",
    "demo:hermes": "bash demo/hermes/run.sh",
    "sentinel": "bun run src/sentinel.ts",
    "server:surgeon": "bun run src/server.ts --role surgeon",
    "smoke:v2": "bun run scripts/smoke-v2.ts",
    "load:sales": "bun run scripts/load-sales.ts",
    "sales:ceiling": "bun run scripts/sales-ceiling.ts",
    "sales:smoke": "bun run scripts/sales-smoke.ts",
    "view:atlas": "bun run src/views/atlas.ts",
    "view:prompt": "bun run src/views/prompt.ts",
    "view:rubric": "bun run src/views/rubric.ts",
    "view:drafts": "bun run src/views/drafts.ts",
    "load:accounts": "bun run scripts/load-accounts.ts",
    "outreach:smoke": "bun run scripts/outreach-smoke.ts",
    "test:all": "bun test --preload ./tests/preload.ts tests/"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
