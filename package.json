{
  "name": "mongo-hack",
  "module": "src/check.ts",
  "type": "module",
  "private": true,
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@langchain/core": "^1.2.12",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/mcp-adapters": "^1.1.4",
    "@langchain/openai": "^1.5.13",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "mongodb": "^7.6.0",
    "openai": "^7.23.0",
    "voyageai": "^0.4.0",
    "zod": "^4.6.5"
  },
  "scripts": {
    "check": "bun run src/check.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks",
    "server": "bun run src/server.ts",
    "setup": "bun run scripts/setup-indexes.ts",
    "smoke": "bun run scripts/smoke.ts",
    "demo:langgraph": "bun run demo/langgraph-agent.ts",
    "demo:reset": "bash demo/reset.sh",
    "demo:clean": "bun run demo/clean.ts && bash demo/reset.sh",
    "demo:hermes": "bash demo/hermes/run.sh"
  },
  "engines": {
    "bun": ">=1.4"
  }
}
