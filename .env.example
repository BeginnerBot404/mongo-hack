# From Atlas Hackathon Sandbox: Connect > Drivers
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hack

# openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# dashboard.voyageai.com > Organization > API Keys
VOYAGE_API_KEY=

# Optional local model for the harness (DEMO_PROVIDER=gb10): OpenAI-compatible endpoint
GB10_BASE_URL=
GB10_MODEL=
GB10_API_KEY=
