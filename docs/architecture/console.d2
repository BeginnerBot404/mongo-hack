direction: right
atlas: "Atlas waypoints" {shape: cylinder}
api: Next.js route handlers {
  stream: "/api/stream\nsnapshot + change stream → SSE"
  history: "/api/history\nobjectives + attached docs"
  alive: "/api/alive\npgrep harness"
  run: "/api/run\nstart/stop (ALLOW_RUN=1)"
}
pages: Pages {
  live: "/ and /live\nNOW WRITING · shape · bar · trace waterfall"
  runs: "/runs → /runs/[id]\nbatch table → Live pinned"
  playbook: "/playbook\none card per version"
  replay: "/replay\nscrubber over history"
}
atlas -> api.stream: change streams
atlas -> api.history: reads
atlas -> pages.runs: server-side reads
atlas -> pages.playbook: server-side reads
api.stream -> pages.live: SSE
api.history -> pages.replay: JSON
api.alive -> pages.live: CRASHED banner
